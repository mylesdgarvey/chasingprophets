# AWS Configuration Template
# Copy this file to .env and fill in your actual values
# WARNING: Never commit the .env file to git!

# AWS Credentials (for backend/setup scripts)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your-account-id-here
AWS_ACCESS_KEY_ID=your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-key-here

# Frontend Environment Variables (exposed to browser)
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=your-user-pool-id-here
VITE_COGNITO_CLIENT_ID=your-client-id-here
VITE_API_ENDPOINT=
VITE_AWS_ACCESS_KEY_ID=your-access-key-here
VITE_AWS_SECRET_ACCESS_KEY=your-secret-key-here
